{
	"name": "mario-deluna/phptv",
	"type": "application",
	"description": "PHP Remote control for Sony Android TVs.",
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"ext-readline": "*",
		"clancats/container": "^1.3",
		"league/climate": "^3.0",
		"psr/http-client": "^1.0",
		"psr/http-factory": "^1.0",
		"psr/http-message": "^2.0",
		"guzzlehttp/guzzle": "^7.5"
	},
	"autoload": {
        "psr-4": {
        	"PHPTv\\": "src/"
        }
    },
	"bin": ["bin/phptv"],
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"shipmonk/coding-standard": "*"
	},
	"scripts": {
		"stan": "vendor/bin/phpstan analyse",
		"cs": "vendor/bin/phpcs",
		"cs-fix": "vendor/bin/phpcbf",
		"qa": ["@cs", "@stan"]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
